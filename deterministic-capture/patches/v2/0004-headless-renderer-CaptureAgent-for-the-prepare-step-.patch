+    : content::RenderFrameObserver(render_frame) {
+  render_frame->GetAssociatedInterfaceRegistry()->AddInterface<mojom::CaptureAgent>(
+      base::BindRepeating(&CaptureAgent::BindReceiver, weak_factory_.GetWeakPtr()));
+}
