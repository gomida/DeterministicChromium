+#ifndef HEADLESS_LIB_BROWSER_PROTOCOL_DETERMINISTIC_CAPTURE_HANDLER_H_
+#define HEADLESS_LIB_BROWSER_PROTOCOL_DETERMINISTIC_CAPTURE_HANDLER_H_
