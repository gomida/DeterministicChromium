+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef HEADLESS_LIB_BROWSER_CAPTURE_RAW_FRAME_SINK_H_
+#define HEADLESS_LIB_BROWSER_CAPTURE_RAW_FRAME_SINK_H_
+
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr_exclusion.h"
+#include "base/synchronization/condition_variable.h"
+#include "base/synchronization/lock.h"
+#include "base/threading/platform_thread.h"
+#include "base/time/time.h"
+#include "headless/lib/browser/capture/canonical_hash.h"
+
+class SkBitmap;
+
+namespace headless::capture {
+
+struct SinkError {
+  int64_t frame_index = -1;
+  int error_number = 0;
+  bool peer_closed = false;
+  int64_t bytes_into_frame = 0;
+  int64_t frames_fully_written = 0;
+  std::string message;
+};
+
+// Destination of canonical frames (DESIGN.md 4.4 and 13.3).
+//   shm:  a shared-memory ring created by the controller; the frame is copied
+//         once into a free slot on the calling (worker) thread, which blocks
+//         while the ring is full, up to stall_timeout.
+//   file: packed canonical BGRA appended to a file through a writer thread
+//         (debugging and tests).
+//   null: frames are counted and dropped.
+// Never writes more than expected_frames.
+class RawFrameSink : public base::PlatformThread::Delegate {
+ public:
+  enum class Type { kNull, kFile, kShm };
+
+  struct Config {
+    Type type = Type::kNull;
+    std::string path;      // kFile
+    int ring_fd = -1;      // kShm: mapping
+    int ready_fd = -1;     // kShm: eventfd signalled after publishing a slot
+    int free_fd = -1;      // kShm: eventfd signalled by the consumer per release
+    std::optional<int64_t> expected_frames;
+    int max_queued_frames = 8;
+    base::TimeDelta stall_timeout = base::Seconds(60);
+  };
+
+  struct Frame {
+    int64_t frame_index = 0;
+    int64_t virtual_time_us = 0;
+    std::shared_ptr<const SkBitmap> bitmap;
+    std::optional<Sha256Digest> hash;
+  };
+
+  explicit RawFrameSink(Config config);
+  RawFrameSink(const RawFrameSink&) = delete;
+  RawFrameSink& operator=(const RawFrameSink&) = delete;
+  ~RawFrameSink() override;
+
+  // Opens the destination: creates the file, or maps and validates the ring.
+  std::optional<SinkError> Open();
+
+  // Writes one frame. May block (file: queue full; shm: ring full) up to
+  // stall_timeout. Returns the first error observed, if any.
+  std::optional<SinkError> Write(const Frame& frame);
+
+  // Finishes the stream: drains the file queue and closes the descriptor, or
+  // marks the ring closed and wakes the consumer. |aborted| marks the stream
+  // incomplete for the consumer.
+  std::optional<SinkError> Close(bool aborted = false);
+
+  int64_t frames_written() const;
+  int64_t frames_queued() const;
+  // Ring geometry for validation by the session (0 when not a ring).
+  int ring_width() const { return ring_width_; }
+  int ring_height() const { return ring_height_; }
+
+ private:
+  struct Pending {
+    int64_t frame_index;
+    std::shared_ptr<const std::vector<uint8_t>> bytes;
+  };
+
+  std::optional<SinkError> OpenRing();
+  std::optional<SinkError> WriteRing(const Frame& frame);
+  std::optional<SinkError> WriteFile(const Frame& frame);
+
+  // base::PlatformThread::Delegate:
+  void ThreadMain() override;
+  bool WriteAll(const Pending& pending, SinkError* error);
+
+  const Config config_;
+  int fd_ = -1;
+  base::PlatformThreadHandle thread_;
+  bool thread_started_ = false;
+
+  // Ring state (kShm). The mapping is mmap(2) memory owned by this object,
+  // not a PartitionAlloc allocation, so raw_ptr does not apply.
+  RAW_PTR_EXCLUSION uint8_t* ring_ = nullptr;
+  size_t ring_size_ = 0;
+  uint32_t slot_count_ = 0;
+  uint64_t slot_bytes_ = 0;
+  uint64_t video_bytes_ = 0;
+  int ring_width_ = 0;
+  int ring_height_ = 0;
+  bool closed_ = false;
+
+  mutable base::Lock lock_;
+  base::ConditionVariable has_data_;
+  base::ConditionVariable has_space_;
+  std::deque<Pending> queue_;
+  bool stop_ = false;
+  std::optional<SinkError> error_;
+  int64_t frames_written_ = 0;
+};
+
+}  // namespace headless::capture
+
+#endif  // HEADLESS_LIB_BROWSER_CAPTURE_RAW_FRAME_SINK_H_
diff --git a/headless/lib/browser/capture/shm_ring.h b/headless/lib/browser/capture/shm_ring.h
new file mode 100644
index 0000000000..aa2228a5e2
--- /dev/null
+++ b/headless/lib/browser/capture/shm_ring.h
@@ -0,0 +1,66 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef HEADLESS_LIB_BROWSER_CAPTURE_SHM_RING_H_
+#define HEADLESS_LIB_BROWSER_CAPTURE_SHM_RING_H_
+
+#include <cstddef>
+#include <cstdint>
+
+// Layout of the shared-memory frame ring between the engine (producer) and
+// the controller's encoder (consumer). The controller creates the mapping,
+// fills the header and passes three descriptors at launch: the ring, a
+// "ready" eventfd the producer signals after publishing a slot and a "free"
+// eventfd the consumer signals after releasing one. All integers are
+// little-endian. The Rust side (deterministic-capture/dcap/src/shm.rs)
+// mirrors these constants; change both together and bump kVersion.
+namespace headless::capture::ring {
+
+inline constexpr uint64_t kMagic = 0x31474E5250414344ULL;  // "DCAPRNG1"
+inline constexpr uint32_t kVersion = 1;
+inline constexpr size_t kHeaderBytes = 4096;
+inline constexpr size_t kSlotHeaderBytes = 256;
+
+// Header fields (byte offsets).
+inline constexpr size_t kOffMagic = 0;               // u64
+inline constexpr size_t kOffVersion = 8;             // u32
+inline constexpr size_t kOffSlotCount = 12;          // u32
+inline constexpr size_t kOffSlotBytes = 16;          // u64, multiple of 4096
+inline constexpr size_t kOffWidth = 24;              // u32
+inline constexpr size_t kOffHeight = 28;             // u32
+inline constexpr size_t kOffStride = 32;             // u32, == width * 4
+inline constexpr size_t kOffPixelFormat = 36;        // u32, kPixelFormatBgra8Premul
+inline constexpr size_t kOffAudioRate = 40;          // u32
+inline constexpr size_t kOffAudioChannels = 44;      // u32
+inline constexpr size_t kOffAudioFormat = 48;        // u32, 0 none, 1 s16, 2 f32
+inline constexpr size_t kOffAudioFramesPerSlot = 52; // u32
+inline constexpr size_t kOffVideoBytes = 56;         // u64, == stride * height
+inline constexpr size_t kOffAudioBytes = 64;         // u64, audio capacity per slot
+inline constexpr size_t kOffProduced = 128;          // u64 atomic, slots published
+inline constexpr size_t kOffConsumed = 192;          // u64 atomic, slots released
+inline constexpr size_t kOffClosed = 256;            // u32 atomic, producer finished
+inline constexpr size_t kOffProducerError = 260;     // u32 atomic, 1 = aborted/incomplete
+
+// Slot fields (byte offsets from the slot start; slot i starts at
+// kHeaderBytes + i * slot_bytes).
+inline constexpr size_t kSlotFrameIndex = 0;         // i64
+inline constexpr size_t kSlotVirtualTimeUs = 8;      // i64, frame time offset
+inline constexpr size_t kSlotFlags = 16;             // u32
+inline constexpr size_t kSlotAudioFrames = 20;       // u32, sample frames present
+inline constexpr size_t kSlotVideoBytes = 24;        // u64, bytes written
+inline constexpr size_t kSlotHash = 32;              // 32 bytes, SHA-256 of video
+inline constexpr size_t kSlotHashPresent = 64;       // u32
+inline constexpr size_t kSlotVideoData = kSlotHeaderBytes;  // then audio
+
+inline constexpr uint32_t kFlagVideo = 1u << 0;
+inline constexpr uint32_t kFlagAudio = 1u << 1;
+
+inline constexpr uint32_t kPixelFormatBgra8Premul = 1;
+inline constexpr uint32_t kAudioFormatNone = 0;
+inline constexpr uint32_t kAudioFormatS16 = 1;
+inline constexpr uint32_t kAudioFormatF32 = 2;
+
+}  // namespace headless::capture::ring
+
+#endif  // HEADLESS_LIB_BROWSER_CAPTURE_SHM_RING_H_
