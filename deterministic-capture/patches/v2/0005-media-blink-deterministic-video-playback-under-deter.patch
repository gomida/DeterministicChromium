+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_BASE_DETERMINISTIC_CAPTURE_H_
+#define MEDIA_BASE_DETERMINISTIC_CAPTURE_H_
+
+#include "base/command_line.h"
+
+namespace media {
+
+// DeterministicChromium: true in processes started with --deterministic-capture
+// (headless_shell forwards the switch to its renderers). Media code uses it to
+// wait for decoded data instead of dropping or underflowing, so that frame
+// selection does not depend on decode speed (deterministic-capture/DESIGN.md
+// 4.5). The switch name is spelled out here because media/ cannot depend on
+// headless/public/switches.h.
+inline bool IsDeterministicCaptureMode() {
+  static const bool enabled =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("deterministic-capture");
+  return enabled;
+}
+
+}  // namespace media
+
+#endif  // MEDIA_BASE_DETERMINISTIC_CAPTURE_H_
diff --git a/media/filters/pipeline_controller.cc b/media/filters/pipeline_controller.cc
index 6ebc6f1f50..f2ba9c8d70 100644
--- a/media/filters/pipeline_controller.cc
+++ b/media/filters/pipeline_controller.cc
@@ -146,6 +146,26 @@ bool PipelineController::IsStable() {
   return state_ == State::PLAYING;
 }
 
+bool PipelineController::HasPendingOperation() {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  switch (state_) {
+    case State::STARTING:
+    case State::SEEKING:
+    case State::SWITCHING_TRACKS:
+    case State::SUSPENDING:
+    case State::RESUMING:
+      return true;
+    case State::STOPPED:
+    case State::PLAYING:
+    case State::PLAYING_OR_SUSPENDED:
+    case State::SUSPENDED:
+      break;
+  }
+  return pending_seek_ || pending_suspend_ || pending_resume_ ||
+         pending_audio_track_change_ || pending_video_track_change_ ||
+         pending_seeked_cb_;
+}
+
 bool PipelineController::IsPendingSeek() {
   DCHECK(thread_checker_.CalledOnValidThread());
   return pending_seek_except_start_;
